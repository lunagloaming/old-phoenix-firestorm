[Unit]
Description=Companion Viewer nightly build, every night

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
# If the machine was off at 03:30, run once at the next start. The job does nothing (one fetch)
# when upstream master and dev haven't changed.
Persistent=true

[Install]
WantedBy=timers.target
